            -- Doldurulan Kısım
            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            SliderFill.BackgroundColor3 = Library.Theme.AccentColor
            SliderFill.Parent = SliderTrack
            AddCorner(SliderFill, UDim.new(1, 0))
            
            -- Sürükleme Mantığı
            local isSliding = false
            local function UpdateSlider(input)
                local absPos = SliderTrack.AbsolutePosition.X
                local absSize = SliderTrack.AbsoluteSize.X
                local mouseX = input.Position.X
                local relativeX = math.clamp((mouseX - absPos) / absSize, 0, 1)
                
                local calculatedVal = math.floor(min + (max - min) * relativeX)
                ValueLabel.Text = tostring(calculatedVal)
                SliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
                Library.Flags[flag] = calculatedVal
                pcall(callback, calculatedVal)
            end
            
            SliderFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    isSliding = true
                    UpdateSlider(input)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if isSliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                    UpdateSlider(input)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    isSliding = false
                end
            end)
        end

