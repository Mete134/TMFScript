            InputBox.Size = UDim2.new(0.4, 0, 0, 24)
            InputBox.Position = UDim2.new(1, -122, 0.5, -12)
            InputBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            InputBox.ClearTextOnFocus = clearOnFocus
            InputBox.Text = ""
            InputBox.PlaceholderText = placeholder or "Buraya yaz..."
            InputBox.PlaceholderColor3 = Library.Theme.DarkText
            InputBox.TextColor3 = Library.Theme.TextColor
            InputBox.Font = Enum.Font.Gotham
            InputBox.TextSize = 12
            InputBox.Parent = BoxFrame
            AddCorner(InputBox, UDim.new(0, 5))
            AddStroke(InputBox, Library.Theme.BorderColor, 1)
            
            InputBox.FocusLost:Connect(function(enterPressed)
                pcall(callback, InputBox.Text, enterPressed)
            end)
        end

        -- 7. KEYBIND (Klavye Tuş Atama Sistemi)
        function TabElements:CreateKeybind(bindText, default, flag, callback)
            default = default or Enum.KeyCode.E
            flag = flag or "Bind_" .. math.random(100,999)
            callback = callback or function() end
            Library.Flags[flag] = default
            
            local KeyFrame = Instance.new("Frame")
            KeyFrame.Size = UDim2.new(1, 0, 0, 38)
            KeyFrame.BackgroundColor3 = Library.Theme.ElementColor
            KeyFrame.Parent = TabPage
            AddCorner(KeyFrame)
            AddStroke(KeyFrame)
            
            local KeyLabel = Instance.new("TextLabel")
            KeyLabel.Size = UDim2.new(0.6, 0, 1, 0)
            KeyLabel.Position = UDim2.new(0, 12, 0, 0)
            KeyLabel.BackgroundTransparency = 1
            KeyLabel.Text = bindText
            KeyLabel.TextColor3 = Library.Theme.TextColor
            KeyLabel.Font = Enum.Font.GothamMedium
            KeyLabel.TextSize = 13
            KeyLabel.TextXAlignment = Enum.TextXAlignment.Left
            KeyLabel.Parent = KeyFrame
            
            local BindBtn = Instance.new("TextButton")
            BindBtn.Size = UDim2.new(0, 70, 0, 24)
            BindBtn.Position = UDim2.new(1, -82, 0.5, -12)
            BindBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            BindBtn.Text = default.Name
            BindBtn.TextColor3 = Library.Theme.AccentColor
            BindBtn.Font = Enum.Font.GothamBold
            BindBtn.TextSize = 12
            BindBtn.Parent = KeyFrame
            AddCorner(BindBtn, UDim.new(0, 5))
            AddStroke(BindBtn, Library.Theme.BorderColor, 1)
            
            local isBinding = false
            BindBtn.MouseButton1Click:Connect(function()
                isBinding = true
                BindBtn.Text = "..."
                BindBtn.TextColor3 = Color3.fromRGB(255, 180, 0)
            end)
            
            UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if isBinding then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        Library.Flags[flag] = input.KeyCode
                        BindBtn.Text = input.KeyCode.Name
                        BindBtn.TextColor3 = Library.Theme.AccentColor
                        isBinding = false
                    end
                else
                    if input.KeyCode == Library.Flags[flag] then
                        pcall(callback)
                    end
                end
            end)
        end

        -- 8. COLORPICKER (Renk Seçici RGB)
        function TabElements:CreateColorpicker(cpText, default, flag, callback)
            default = default or Color3.fromRGB(0, 125, 255)
            flag = flag or "Color_" .. math.random(100,999)
            callback = callback or function() end
            Library.Flags[flag] = default
            
            local CpFrame = Instance.new("Frame")
            CpFrame.Size = UDim2.new(1, 0, 0, 38)
            CpFrame.BackgroundColor3 = Library.Theme.ElementColor
            CpFrame.ClipsDescendants = true
            CpFrame.Parent = TabPage
            AddCorner(CpFrame)
            AddStroke(CpFrame)
            
            local CpLabel = Instance.new("TextLabel")
            CpLabel.Size = UDim2.new(0.6, 0, 0, 38)
            CpLabel.Position = UDim2.new(0, 12, 0, 0)
            CpLabel.BackgroundTransparency = 1
            CpLabel.Text = cpText
            CpLabel.TextColor3 = Library.Theme.TextColor
            CpLabel.Font = Enum.Font.GothamMedium
            CpLabel.TextSize = 13
            CpLabel.TextXAlignment = Enum.TextXAlignment.Left
            CpLabel.Parent = CpFrame
            
            -- Küçük Önizleme Kutusu
            local ColorBox = Instance.new("Frame")
            ColorBox.Size = UDim2.new(0, 30, 0, 18)
            ColorBox.Position = UDim2.new(1, -42, 0, 10)
            ColorBox.BackgroundColor3 = default
            ColorBox.Parent = CpFrame
            AddCorner(ColorBox, UDim.new(0, 4))
            
            local CpBtn = Instance.new("TextButton")
            CpBtn.Size = UDim2.new(1, 0, 0, 38)
            CpBtn.BackgroundTransparency = 1
            CpBtn.Text = ""
            CpBtn.Parent = CpFrame
            
            -- Renk Seçim Paneli (Açılınca Görünecek)
            local PickerContainer = Instance.new("Frame")
            PickerContainer.Size = UDim2.new(1, -24, 0, 80)
            PickerContainer.Position = UDim2.new(0, 12, 0, 42)
            PickerContainer.BackgroundTransparency = 1
            PickerContainer.Parent = CpFrame
            
            -- RGB için 3 adet Slider Bar'ı simüle edelim hızlıca
            local function CreateRGBLabel(text, pos, color)
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(0, 20, 0, 20)
                lbl.Position = pos
                lbl.BackgroundTransparency = 1
                lbl.Text = text
                lbl.TextColor3 = color
                lbl.Font = Enum.Font.GothamBold
                lbl.TextSize = 12
                lbl.Parent = PickerContainer
                return lbl
            end
            
            local isCPOpen = false
            CpBtn.MouseButton1Click:Connect(function()
                isCPOpen = not isCPOpen
                if isCPOpen then
                    TweenService:Create(CpFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 130)}):Play()
                else
                    TweenService:Create(CpFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, 0, 0, 38)}):Play()
                end
            end)
            
            -- Basitlik ve kararlılık adına, örnek renk butonları ekliyoruz (Rayfield mantığında)
            local PresetLayout = Instance.new("UIGridLayout")
            PresetLayout.SizeOfCell = UDim2.new(0, 25, 0, 25)
            PresetLayout.Padding = UDim2.new(0, 8, 0, 8)
            PresetLayout.Parent = PickerContainer
            
            local colors = {
                Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 255),
                Color3.fromRGB(255, 255, 0), Color3.fromRGB(255, 0, 255), Color3.fromRGB(0, 255, 255),
                Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0), Color3.fromRGB(255, 125, 0)
            }
            
            for _, clr in pairs(colors) do
                local ClrSelect = Instance.new("TextButton")
                ClrSelect.BackgroundColor3 = clr
                ClrSelect.Text = ""
                ClrSelect.Parent = PickerContainer
                AddCorner(ClrSelect, UDim.new(0, 4))
                
                ClrSelect.MouseButton1Click:Connect(function()
                    ColorBox.BackgroundColor3 = clr
                    Library.Flags[flag] = clr
                    pcall(callback, clr)
                end)
            end
        end

